generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SessionStatus {
  IDLE
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum SessionType {
  FOCUS
  SHORT_BREAK
  LONG_BREAK
}

enum SessionEventType {
  START
  PAUSE
  RESUME
  COMPLETE
  CANCEL
}

model User {
  id          String           @id @default(cuid())
  email       String           @unique
  name        String?
  image       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  tasks       Task[]
  sessions    PomodoroSession[]
  settings    UserSettings?
  liveSession UserLiveSession?
}

// Cross-device settings for signed-in users. One row per user; the client
// clock (clientUpdatedAt) drives last-write-wins so a newer device wins.
model UserSettings {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  prefs           Json     @default("{}")
  pomodoro        Json     @default("{}")
  ambient         Json     @default("{}")
  diversions      Json     @default("[]")
  clientUpdatedAt BigInt   @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

// Live timer state for signed-in users, so an in-progress (or paused) session
// continues seamlessly on another device. Timer math is timestamp-based, so the
// absolute timestamps round-trip exactly. Last-write-wins on the client clock.
model UserLiveSession {
  userId          String   @id
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state           Json     @default("{}")
  clientUpdatedAt BigInt   @default(0)
  updatedAt       DateTime @updatedAt
  createdAt       DateTime @default(now())
}

model Task {
  id               String            @id @default(cuid())
  userId           String?
  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  date             DateTime          @default(now()) @db.Date
  allocatedMinutes Int               @default(60)
  status           TaskStatus        @default(TODO)
  // Per-task pomodoro overrides (nullable = use global defaults from constants)
  focusDuration    Int?
  shortBreak       Int?
  longBreak        Int?
  // Cloud-sync mirrors of the local-first client state (see src/lib/sync.ts)
  longBreakInterval  Int?
  project            String?
  priority           String            @default("medium")
  focusedMinutes     Int               @default(0)
  completedPomodoros Int               @default(0)
  // Focus scheduling mode (allocated = classic Pomodoro, infinite = open-ended)
  focusMode          String            @default("allocated")
  sessionName        String?
  focusedMs          Int               @default(0)
  breakMs            Int               @default(0)
  interruptions      Int               @default(0)
  completedFocusCount Int              @default(0)
  lastPhase          String?
  subtasks           Json              @default("[]")
  startMs            BigInt?
  endMs              BigInt?
  // Google Calendar link (Phase 06)
  calendarEventId  String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  sessions         PomodoroSession[]

  @@index([date])
  @@index([status])
  @@index([userId])
  @@index([userId, date])
}

model PomodoroSession {
  id             String         @id @default(cuid())
  userId         String?
  user           User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId         String?
  task           Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  type           SessionType    @default(FOCUS)
  status         SessionStatus  @default(IDLE)
  plannedMinutes Int            @default(50)
  // Cloud-sync mirrors of the local-first client state (see src/lib/sync.ts)
  taskTitle      String?
  focusedMs      Int            @default(0)
  pausedMs       Int            @default(0)
  interruptions  Int            @default(0)
  sessionMode    String         @default("allocated")
  sessionName    String?
  breakMs        Int            @default(0)
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  events         SessionEvent[]

  @@index([taskId])
  @@index([status])
  @@index([startedAt])
  @@index([userId])
}

model SessionEvent {
  id        String           @id @default(cuid())
  sessionId String
  session   PomodoroSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  type      SessionEventType
  timestamp DateTime         @default(now())

  @@index([sessionId])
  @@index([timestamp])
}
